# ============================================================
# POSGA - CONTOH ENVIRONMENT PRODUCTION
# ============================================================

NODE_ENV=production
PORT=3000

# ============================================================
# ADMIN AWAL
#
# Variabel ini hanya diperlukan saat menjalankan:
# npm run seed:admin
#
# Jangan commit password asli.
# ============================================================

POSGA_ADMIN_USERNAME=admin
POSGA_ADMIN_NAME=Administrator POSGA
POSGA_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# ============================================================
# PENTING
#
# JANGAN menambahkan:
# POSGA_TEST_BYPASS_AUTH=1
#
# Flag tersebut hanya untuk automated test.
# ============================================================
