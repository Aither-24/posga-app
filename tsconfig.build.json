{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "noEmit": false,

    "declaration": false,
    "declarationMap": false,

    "sourceMap": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "legacy",

    "src/tests",
    "src/tests/**",

    "backup-*",
    "backup-*/**",

    "patch-files",
    "patch-files/**",

    "_patch-backups",
    "_patch-backups/**"
  ]
}
