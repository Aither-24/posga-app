{
    "name": "posga-app",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/output.css",
        "watch:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/output.css --watch",
        "copy:alpine": "shx cp node_modules/alpinejs/dist/cdn.min.js public/js/alpine.js",
        "check": "tsc --noEmit",
        "test:final-data": "tsx src/tests/test-final-data-validation.ts",
        "test:export": "tsx src/tests/test-api-export-excel.ts",
        "build": "npm run clean && npm run build:css && npm run build:server",
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "build:server": "tsc -p tsconfig.build.json",
        "migrate": "node dist/db/run-migrate.js",
        "seed:indikator": "node dist/db/seed-indikator-posga.js",
        "seed:admin": "node dist/db/seed-admin.js",
        "preinstall": "node scripts/check-node-version.mjs",
        "db:setup:dev": "tsx src/db/run-migrate.ts && tsx src/db/seed-indikator-posga.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@pedi-growth/core": "^1.1.0",
        "alpinejs": "^3.17.1",
        "better-sqlite3": "12.11.1",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "googleapis": "^178.0.0",
        "xlsx": "^0.18.5",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.6",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "^0.31.10",
        "shx": "^0.4.0",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "better-sqlite3@13.0.3": true,
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "@parcel/watcher@2.5.1": true
    },
    "engines": {
        "node": ">=24 <25"
    }
}
