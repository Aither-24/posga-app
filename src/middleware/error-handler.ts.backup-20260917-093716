import type {
  ErrorRequestHandler,
  RequestHandler,
} from "express";

import {
  ApiError,
} from "../lib/api-error.js";

// ============================================================
// RESPONSE TYPE
// ============================================================

export interface ApiErrorResponse {
  success: false;

  error: {
    message: string;
  };
}

// ============================================================
// 404 ROUTE
// ============================================================

export const notFoundHandler:
  RequestHandler =
    (
      _req,
      res,
    ) => {
      res.status(404).json({
        success: false,

        error: {
          message:
            "Endpoint tidak ditemukan.",
        },
      });
    };

// ============================================================
// LEGACY SERVICE ERROR
//
// Sebagian service lama masih menggunakan:
//
// throw new Error(...)
//
// Untuk menjaga kompatibilitas, error domain yang memang
// ditujukan kepada pengguna tetap diterjemahkan menjadi 4xx.
//
// Error yang tidak dikenali tidak lagi otomatis dianggap 400.
// Error tersebut akan diperlakukan sebagai error internal 500.
// ============================================================

function deteksiStatusError(
  message: string,
):
  | 400
  | 401
  | 404
  | 409
  | null {
  const lower =
    message
      .trim()
      .toLowerCase();

  // ==========================================================
  // ERROR INTERNAL YANG SUDAH DIKENAL
  //
  // Pesan seperti "gagal menyimpan" menunjukkan operasi
  // internal tidak berhasil dan tidak seharusnya diekspos
  // langsung kepada client.
  // ==========================================================

  if (
    lower.includes("gagal ")
  ) {
    return null;
  }

  // ==========================================================
  // 401 - AUTH LEGACY
  // ==========================================================

  if (
    lower.includes(
      "token autentikasi tidak ditemukan",
    )
  ) {
    return 401;
  }

  // ==========================================================
  // 404 - RESOURCE TIDAK DITEMUKAN
  // ==========================================================

  if (
    lower.includes(
      "tidak ditemukan",
    )
  ) {
    return 404;
  }

  // ==========================================================
  // 409 - CONFLICT
  //
  // Dipertahankan kompatibel dengan perilaku lama.
  // ==========================================================

  const conflictPatterns = [
    "sudah tercatat",
    "sudah terdaftar",
    "sudah ada",
    "duplikat",
    "masih aktif",
    "masih memiliki",
    "sudah memiliki",
    "tidak boleh dihapus",
    "tidak dapat ditambahkan",
    "hanya episode",
  ];

  if (
    conflictPatterns.some(
      (pattern) =>
        lower.includes(pattern),
    )
  ) {
    return 409;
  }

  // ==========================================================
  // 400 - VALIDASI / ATURAN DOMAIN LEGACY
  //
  // Error domain lama masih banyak menggunakan Error biasa.
  // Daftar ini menjaga kompatibilitas tanpa menjadikan semua
  // Error sebagai bad request.
  // ==========================================================

  const badRequestPatterns = [
    "tidak valid",
    "harus ",
    "wajib",
    "tidak boleh",
    "tidak dapat",
    "bukan ",
    "membutuhkan",
    "minimal",
    "lebih besar",
    "lebih awal",
    "tidak aktif",
    "tidak sesuai",
    "belum didukung",
    "bertipe ",
    "tanggal ",
    "usia ",
    "nilai ",
    "peserta ",
    "posyandu ",
    "indikator ",
    "opsi ",
    "sesi ",
    "skrining ",
    "konseling ",
    "episode ",
    "hasil ",
    "nik ",
    "aturan",
    "form ",
  ];

  if (
    badRequestPatterns.some(
      (pattern) =>
        lower.includes(pattern),
    )
  ) {
    return 400;
  }

  // ==========================================================
  // UNKNOWN ERROR
  //
  // Tidak dikenali sebagai error domain.
  // Perlakukan sebagai internal server error.
  // ==========================================================

  return null;
}

// ============================================================
// GLOBAL ERROR HANDLER
// ============================================================

export const errorHandler:
  ErrorRequestHandler =
    (
      error,
      _req,
      res,
      _next,
    ) => {
      // ========================================================
      // API ERROR EKSPLISIT
      //
      // Ini merupakan mekanisme error yang direkomendasikan
      // untuk kode baru.
      // ========================================================

      if (
        error instanceof
        ApiError
      ) {
        res
          .status(
            error.statusCode,
          )
          .json({
            success:
              false,

            error: {
              message:
                error.message,
            },
          });

        return;
      }

      // ========================================================
      // LEGACY ERROR
      // ========================================================

      if (
        error instanceof
        Error
      ) {
        const status =
          deteksiStatusError(
            error.message,
          );

        if (status !== null) {
          console.warn(
            "API DOMAIN ERROR:",
            error.message,
          );

          res
            .status(status)
            .json({
              success:
                false,

              error: {
                message:
                  error.message,
              },
            });

          return;
        }

        // ======================================================
        // INTERNAL ERROR
        //
        // Detail dicatat pada server, tetapi tidak dikirim
        // kepada client.
        // ======================================================

        console.error(
          "API INTERNAL ERROR:",
          error,
        );

        res
          .status(500)
          .json({
            success:
              false,

            error: {
              message:
                "Terjadi kesalahan internal.",
            },
          });

        return;
      }

      // ========================================================
      // UNKNOWN NON-ERROR VALUE
      // ========================================================

      console.error(
        "API UNKNOWN ERROR:",
        error,
      );

      res
        .status(500)
        .json({
          success: false,

          error: {
            message:
              "Terjadi kesalahan internal.",
          },
        });
    };
